# Cloudflare Pages reads this file from the build output root and applies
# these headers automatically — no dashboard config needed. Same rules
# that used to live in netlify.toml.

/assets/*
  Cache-Control: public, max-age=300, must-revalidate

# style.css and script.js are NOT filename-hashed — they can change in
# place on a deploy, so they get a short cache instead of "immutable".
# (Cloudflare's own CDN still serves the new version instantly on
# deploy; this only controls how long a visitor's browser trusts its
# old copy.)
/style.css
  Cache-Control: public, max-age=3600, must-revalidate

/script.js
  Cache-Control: public, max-age=3600, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=86400, must-revalidate

# HTML is never cached for long. It names the CSS and JS version, so a stale
# page would keep pointing at files a browser had cached.
/
  Cache-Control: no-cache

/article/*
  Cache-Control: no-cache

/articles/*
  Cache-Control: no-cache

/wallpaper/*
  Cache-Control: no-cache

/category/*
  Cache-Control: no-cache

/categories/*
  Cache-Control: no-cache

/about/*
  Cache-Control: no-cache

/contact/*
  Cache-Control: no-cache

/privacy/*
  Cache-Control: no-cache

/terms/*
  Cache-Control: no-cache

/dmca/*
  Cache-Control: no-cache

/search/*
  Cache-Control: no-cache

/favorites/*
  Cache-Control: no-cache

/thank-you/*
  Cache-Control: no-cache

/404.html
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
