<!-- ============ FOOTER ============ -->
<footer class="site-footer">
  <div class="footer-inner">

    <div class="footer-stats glass">
      <span class="footer-stat-item">4K to 8K resolutions</span>
      <span class="footer-stat-sep">&middot;</span>
      <span class="footer-stat-item">Desktop &amp; Mobile</span>
      <span class="footer-stat-sep">&middot;</span>
      <span class="footer-stat-item">No signup required</span>
      <span class="footer-stat-sep">&middot;</span>
      <span class="footer-stat-item">Free forever</span>
    </div>

    <div class="footer-columns">
      <div class="footer-col footer-brand">
        <div class="footer-logo">
          <svg class="logo-icon" width="51" height="34" viewBox="0 0 150 100" fill="none" aria-hidden="true">
            <defs>
              <linearGradient id="wGradFoot" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#ffffff"/>
                <stop offset="1" stop-color="#cfcbc0"/>
              </linearGradient>
              <linearGradient id="wDotGradFoot" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#f5c877"/>
                <stop offset="1" stop-color="#d4901f"/>
              </linearGradient>
            </defs>
            <path d="M16 27 L42 83 L66 45 L90 83 L116 27" stroke="#8f8b80" stroke-width="24" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <path d="M12 22 L38 78 L62 40 L86 78 L112 22" stroke="url(#wGradFoot)" stroke-width="24" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <circle cx="129" cy="80" r="17" fill="#a8752a"/>
            <circle cx="126" cy="76" r="17" fill="url(#wDotGradFoot)"/>
          </svg>
          <span class="logo-text">WallDrop<span class="logo-accent">4K</span></span>
        </div>
        <p class="footer-desc">{{ settings.description }}</p>
      </div>
      <div class="footer-col">
        <h4 class="footer-col-title">Desktop</h4>
        <ul>
          {% for slug in categories.footerDesktop %}
          {% set cat = categories.desktop | findBySlug(slug) %}
          <li><a href="/category/desktop/{{ slug }}/">{{ cat.name }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div class="footer-col">
        <h4 class="footer-col-title">Mobile</h4>
        <ul>
          {% for slug in categories.footerMobile %}
          {% set cat = categories.mobile | findBySlug(slug) %}
          <li><a href="/category/mobile/{{ slug }}/">{{ cat.name }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div class="footer-col">
        <h4 class="footer-col-title">Company</h4>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/dmca/">DMCA</a></li>
          <li><a href="/terms/">Terms</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-tags">
      <a href="/category/desktop/nature/" class="pill">Nature</a>
      <a href="/category/desktop/gaming/" class="pill">Gaming</a>
      <a href="/category/desktop/dark/" class="pill">Dark</a>
      <a href="/category/desktop/anime/" class="pill">Anime</a>
      <a href="/category/desktop/minimal/" class="pill">Minimal</a>
      <a href="/category/desktop/abstract/" class="pill">Abstract</a>
      <a href="/category/desktop/4k/" class="pill">4K</a>
      <a href="/category/desktop/8k/" class="pill">8K</a>
      <a href="/category/mobile/iphone/" class="pill">iPhone</a>
      <a href="/category/mobile/samsung/" class="pill">Samsung</a>
      <a href="/category/desktop/space/" class="pill">Space</a>
      <a href="/category/desktop/city/" class="pill">City</a>
      <a href="/category/desktop/cars/" class="pill">Cars</a>
      <a href="/category/mobile/amoled/" class="pill">AMOLED</a>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 {{ settings.title }}. All rights reserved.</p>
      <p class="footer-notice">All wallpapers are the property of their respective owners.</p>
    </div>

  </div>
</footer>
