<!-- ============ FOOTER ============ -->
<footer class="site-footer">
  <div class="footer-inner">

    <div class="footer-columns">
      <div class="footer-col footer-brand">
        <div class="footer-logo">
          <svg class="logo-icon" width="51" height="34" viewBox="0 0 150 100" fill="none" aria-hidden="true">
            <defs>
              <linearGradient id="wGradFoot" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#ffffff"/>
                <stop offset="1" stop-color="#cfcbc0"/>
              </linearGradient>
              <linearGradient id="wDotGradFoot" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#f5c877"/>
                <stop offset="1" stop-color="#d4901f"/>
              </linearGradient>
            </defs>
            <path d="M16 27 L42 83 L66 45 L90 83 L116 27" stroke="#8f8b80" stroke-width="24" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <path d="M12 22 L38 78 L62 40 L86 78 L112 22" stroke="url(#wGradFoot)" stroke-width="24" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <circle cx="129" cy="80" r="17" fill="#a8752a"/>
            <circle cx="126" cy="76" r="17" fill="url(#wDotGradFoot)"/>
          </svg>
          <span class="logo-text">WallDrop<span class="logo-accent">4K</span></span>
        </div>
        <p class="footer-desc">{{ settings.description }}</p>
        {% if settings.social and (settings.social.twitter or settings.social.instagram or settings.social.pinterest) %}
        <div class="footer-social">
          {% if settings.social.twitter %}
          <a href="{{ settings.social.twitter }}" class="footer-social-icon" aria-label="Twitter / X" target="_blank" rel="noopener">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l16 16"></path><path d="M20 4L4 20"></path></svg>
          </a>
          {% endif %}
          {% if settings.social.instagram %}
          <a href="{{ settings.social.instagram }}" class="footer-social-icon" aria-label="Instagram" target="_blank" rel="noopener">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"></circle></svg>
          </a>
          {% endif %}
          {% if settings.social.pinterest %}
          <a href="{{ settings.social.pinterest }}" class="footer-social-icon" aria-label="Pinterest" target="_blank" rel="noopener">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M9 19c1-3 2-8 2-10a2.5 2.5 0 0 1 5 0c0 1.5-1 4-3 4"></path></svg>
          </a>
          {% endif %}
        </div>
        {% endif %}
      </div>
      <div class="footer-col">
        <h4 class="footer-col-title">Explore</h4>
        <ul>
          {% for slug in categories.footerDesktop.slice(0, 3) %}
          {% if occupiedCategories["desktop/" + slug] %}
          {% set cat = categories.desktop | findBySlug(slug) %}
          <li><a href="/category/desktop/{{ slug }}/">{{ cat.name }}</a></li>
          {% endif %}
          {% endfor %}
          {% for slug in categories.footerMobile.slice(0, 3) %}
          {% if occupiedCategories["mobile/" + slug] %}
          {% set cat = categories.mobile | findBySlug(slug) %}
          <li><a href="/category/mobile/{{ slug }}/">{{ cat.name }}</a></li>
          {% endif %}
          {% endfor %}
        </ul>
      </div>
      <div class="footer-col">
        <h4 class="footer-col-title">Resources</h4>
        <ul>
          <li><a href="/articles/">Articles</a></li>
          <li><a href="/favorites/">Favorites</a></li>
          <li><a href="/search/">Search</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4 class="footer-col-title">Legal</h4>
        <ul>
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/dmca/">DMCA</a></li>
          <li><a href="/terms/">Terms</a></li>
        </ul>
      </div>
    </div>

    {% set footerTagList = [
      {type:"desktop", slug:"nature", name:"Nature"},
      {type:"desktop", slug:"gaming", name:"Gaming"},
      {type:"desktop", slug:"dark", name:"Dark"},
      {type:"desktop", slug:"anime", name:"Anime"},
      {type:"desktop", slug:"minimal", name:"Minimal"},
      {type:"desktop", slug:"abstract", name:"Abstract"},
      {type:"desktop", slug:"4k", name:"4K"},
      {type:"desktop", slug:"8k", name:"8K"},
      {type:"mobile", slug:"iphone", name:"iPhone"},
      {type:"mobile", slug:"samsung", name:"Samsung"},
      {type:"desktop", slug:"space", name:"Space"},
      {type:"desktop", slug:"city", name:"City"},
      {type:"desktop", slug:"cars", name:"Cars"},
      {type:"mobile", slug:"amoled", name:"AMOLED"}
    ] %}
    <div class="footer-tags">
      {% for tag in footerTagList %}
      {% if occupiedCategories[tag.type + "/" + tag.slug] %}
      <a href="/category/{{ tag.type }}/{{ tag.slug }}/" class="pill">{{ tag.name }}</a>
      {% endif %}
      {% endfor %}
    </div>

    <div class="footer-stats glass">
      <span class="footer-stat-item">4K to 8K resolutions</span>
      <span class="footer-stat-sep">&middot;</span>
      <span class="footer-stat-item">Desktop &amp; Mobile</span>
      <span class="footer-stat-sep">&middot;</span>
      <span class="footer-stat-item">No signup required</span>
      <span class="footer-stat-sep">&middot;</span>
      <span class="footer-stat-item">Free forever</span>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 {{ settings.title }}. All rights reserved.</p>
      <p class="footer-notice">All wallpapers are the property of their respective owners.</p>
    </div>

  </div>
</footer>
