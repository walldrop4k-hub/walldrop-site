{# Reusable card renderers, shared by the homepage, category pages, related
   sections, and the search and favorites pages. script.js builds the same
   markup in renderWallpaperCard, so keep the two in step. #}

{% macro downloadIcon() %}<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"></path><path d="M7 10l5 5 5-5"></path><path d="M4 19h16"></path></svg>{% endmacro %}

{# Renders an <img>, falling back to the gradient placeholder if the URL
   fails, so a visitor never sees a broken-image icon. When the image
   finishes loading (or fails), the parent gets .is-loaded, which removes
   the shimmer sweep. fit defaults to "cover". #}
{% macro mediaOrFallback(src, alt, cssClass, gradientClass, fit="cover", loading="eager") %}
{% if src %}<img class="{{ cssClass }}" src="{{ src }}" alt="{{ alt }}" loading="{{ loading }}" decoding="async" style="object-fit:{{ fit }};" onload="this.parentElement.classList.add('is-loaded');" onerror="this.style.display='none';this.nextElementSibling.style.display='block';this.parentElement.classList.add('is-loaded');"><div class="{{ cssClass }} {{ gradientClass or 'grad-1' }}" style="display:none;"></div>{% else %}<div class="{{ cssClass }} {{ gradientClass or 'grad-1' }}"></div>{% endif %}
{% endmacro %}

{# The one wallpaper card used everywhere. Shows the title, and on hover the
   resolution badge and download icon slide in. No category label. The glow
   color is this wallpaper's own dominant color, computed at build time. #}
{% macro wallpaperCard(w, extraClass="", loading="lazy") %}
{% set ratio = "ratio-16-9" if w.data.category == "desktop" else "ratio-9-16" %}
{% set glow = w.data.imageMeta.dominantColor if w.data.imageMeta else "#8b7bff" %}
<a href="{{ w.url }}" class="wallpaper-card reveal {{ extraClass }}" style="--glow:{{ glow }}" data-category="{{ w.data.category }}" data-subcategory="{{ (w.data.subcategory or '') | lower }}" data-tags="{{ ((w.data.tags or []) | join(',')) | lower }}" data-date="{{ w.data.date | isoDate }}">
  <div class="thumb {{ ratio }}{{ ' has-image' if w.data.cardImage }}">
    {{ mediaOrFallback(w.data.cardImage, w.data.imageAlt or w.data.title, "thumb-bg", w.data.gradientClass, "cover", loading) }}
    {% if w.data.imageMeta %}<span class="res-badge">{{ w.data.imageMeta.label }}</span>{% endif %}
    {# Decorative only. The whole card is the click target; the real
       download link is on the wallpaper's own page. #}
    <span class="download-btn" aria-hidden="true">{{ downloadIcon() }}</span>
  </div>
  <div class="card-info">
    <h3 class="card-title">{{ w.data.title }}</h3>
  </div>
</a>
{% endmacro %}

{# Trending cards are the same card, so the look stays identical. #}
{% macro trendingCard(w, loading="lazy") %}
{{ wallpaperCard(w, "", loading) }}
{% endmacro %}

{% macro articleCard(a, showExcerpt=true, loading="lazy") %}
<a href="{{ a.url }}" class="article-card reveal">
  <div class="thumb{{ ' has-image' if a.data.featuredImage }}">
    {{ mediaOrFallback(a.data.featuredImage, a.data.imageAlt or a.data.title, "thumb-bg", a.data.gradientClass, "cover", loading) }}
  </div>
  <div class="card-info">
    <p class="card-eyebrow">{{ a.data.category }}</p>
    <h3 class="card-title">{{ a.data.title }}</h3>
    {% if showExcerpt %}
    <p class="card-excerpt">{{ a.data.excerpt | plainText(300) }}</p>
    <p class="card-meta">{{ a.data.readTime }}</p>
    {% endif %}
  </div>
</a>
{% endmacro %}
