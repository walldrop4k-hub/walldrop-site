{# Reusable card/tile renderers, shared by the homepage, category pages,
   and "related" sections — one definition per card type instead of the
   same markup hand-copied in five places. #}

{% macro downloadIcon() %}<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"></path><path d="M7 10l5 5 5-5"></path><path d="M4 19h16"></path></svg>{% endmacro %}

{# Renders an <img>, but falls back to the gradient placeholder look if
   the image URL ever 404s (a broken upload, a deploy that hasn't fully
   propagated yet, a since-deleted file) — so a visitor only ever sees a
   clean placeholder, never a broken-image icon. cssClass carries any
   positioning classes (e.g. "thumb-bg", "preview-media ratio-16-9") so
   the fallback div lines up exactly like the image would have. fit
   defaults to "cover" (fills the box, crops if needed — right for
   fixed-size grid cards); pass "contain" for a spot like the wallpaper
   detail preview, where the whole image must stay visible uncropped. #}
{% macro mediaOrFallback(src, alt, cssClass, gradientClass, fit="cover") %}
{% if src %}<img class="{{ cssClass }}" src="{{ src }}" alt="{{ alt }}" style="width:100%;height:100%;object-fit:{{ fit }};" onerror="this.style.display='none';this.nextElementSibling.style.display='block';"><div class="{{ cssClass }} {{ gradientClass or 'grad-1' }}" style="display:none;"></div>{% else %}<div class="{{ cssClass }} {{ gradientClass or 'grad-1' }}"></div>{% endif %}
{% endmacro %}

{% macro wallpaperCard(w, extraClass="") %}
{% set cat = categories[w.data.category] | findBySlug(w.data.subcategory) %}
{% set ratio = "ratio-16-9" if w.data.category == "desktop" else "ratio-9-16" %}
{# data-* attributes carry no visual effect — they're read by script.js
   for the category-page chip filter/sort (see .chip-row / .sort-select). #}
<a href="{{ w.url }}" class="wallpaper-card {{ extraClass }}" data-category="{{ w.data.category }}" data-subcategory="{{ (w.data.subcategory or '') | lower }}" data-tags="{{ ((w.data.tags or []) | join(',')) | lower }}" data-date="{{ w.data.date | isoDate }}">
  <div class="thumb {{ ratio }}">
    {# Grid tiles load the lighter "thumbnail" field, falling back to the
       full image if no thumbnail was uploaded — the full image is only
       ever linked from the wallpaper's own download button (wallpaper.njk). #}
    {{ mediaOrFallback(w.data.thumbnail or w.data.image, w.data.title, "thumb-bg", w.data.gradientClass) }}
    <span class="tag">{{ cat.name if cat else w.data.subcategory }}</span>
    {# Decorative only — not a real control, so it can't be the thing a
       tap lands on. The whole card is the one click target; the actual
       download link lives on the wallpaper's own page. #}
    <span class="download-btn" aria-hidden="true">{{ downloadIcon() }}</span>
  </div>
  <div class="card-info">
    <h3 class="card-title">{{ w.data.title }}</h3>
    <p class="card-res">{{ w.data.resolutions[0].dimensions if w.data.resolutions and w.data.resolutions.length else "" }}</p>
  </div>
</a>
{% endmacro %}

{% macro trendingCard(w) %}
{% set cat = categories[w.data.category] | findBySlug(w.data.subcategory) %}
{% set ratio = "ratio-16-9" if w.data.category == "desktop" else "ratio-9-16" %}
<a href="{{ w.url }}" class="trending-card {{ ratio }} fade-item">
  {{ mediaOrFallback(w.data.thumbnail or w.data.image, w.data.title, "trending-bg", w.data.gradientClass) }}
  <div class="trending-overlay"></div>
  <span class="tag">{{ cat.name if cat else w.data.subcategory }}</span>
  <div class="trending-info">
    <h3 class="card-title">{{ w.data.title }}</h3>
    <p class="card-res">{{ w.data.resolutions[0].dimensions if w.data.resolutions and w.data.resolutions.length else "" }}</p>
  </div>
</a>
{% endmacro %}

{% macro articleCard(a, showExcerpt=true) %}
<a href="{{ a.url }}" class="article-card fade-item">
  <div class="thumb">
    {{ mediaOrFallback(a.data.image, a.data.title, "thumb-bg", a.data.gradientClass) }}
  </div>
  <div class="card-info">
    <p class="card-eyebrow">{{ a.data.category }}</p>
    <h3 class="card-title">{{ a.data.title }}</h3>
    {% if showExcerpt %}
    <p class="card-excerpt">{{ a.data.excerpt }}</p>
    <p class="card-meta">{{ a.data.readTime }}</p>
    {% endif %}
  </div>
</a>
{% endmacro %}
