<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#07070b">
<script>document.documentElement.classList.add('js');</script>
{% set baseTitle = seoTitle or title %}
{% set pageTitle = (baseTitle + " — " + settings.title) if baseTitle else (settings.title + " — " + settings.tagline) %}
{% set pageDescription = metaDescription or settings.description %}
{% set pageImage = site.url + (ogImage or defaultOgImage or "/favicon.svg") %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="{{ site.url }}{{ page.url | canonicalPath }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<meta name="p:domain_verify" content="3a2e8fa6212339c4c429ce1bd7498992"/>
<link rel="alternate" type="application/rss+xml" title="{{ settings.title }}" href="/feed.xml">

<!-- Open Graph / Twitter — every value comes from src/_data/site.json's
     "url" field, so nothing here needs editing when the real domain
     goes live; just update that one field. -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ settings.title }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ site.url }}{{ page.url | canonicalPath }}">
<meta property="og:image" content="{{ pageImage }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ pageImage }}">

<!-- Fonts are self-hosted. Only the two faces used above the fold are
     preloaded: Space Grotesk 700 for headings and Inter 400 for body text. -->
<link rel="preload" href="/assets/fonts/space-grotesk-700.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin>


{% if page.url == "/" and collections.heroWallpapers.length %}
{% set heroFirst = collections.heroWallpapers[0].data %}
<link rel="preload" as="image" href="{{ heroFirst.displayImage }}" imagesrcset="{{ heroFirst.displayImageSrcset }}" imagesizes="100vw" fetchpriority="high">
{% elif displayImage %}
<link rel="preload" as="image" href="{{ displayImage }}" imagesrcset="{{ displayImageSrcset }}" imagesizes="(min-width: 900px) 55vw, 100vw" fetchpriority="high">
{% endif %}
{% if page.url == "/" %}
<!-- Homepage only: critical CSS (header and hero) is inlined so the first paint
     needs no request, and the full stylesheet loads without blocking render.
     The hero layout is covered by the critical rules, so nothing shifts when
     the full sheet arrives. -->
<style>{{ "src/critical.css" | inlineCss | safe }}</style>
<link rel="preload" href="/style.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="/style.css"></noscript>
{% else %}
<!-- Other pages: a normal stylesheet link. Their layout is not covered by the
     critical rules, so the stylesheet must apply before the first paint. -->
<link rel="stylesheet" href="/style.css">
{% endif %}
<link rel="icon" type="image/svg+xml" href="/favicon.svg">

<!-- BreadcrumbList JSON-LD on every page except the homepage. Pages that
     set their own "breadcrumbs" (wallpapers, articles, categories) use
     that trail; every other page gets Home > this page. -->
{% if page.url != "/" %}
{% set crumbs = breadcrumbs or [{ name: "Home", url: "/" }, { name: title, url: page.url | canonicalPath }] %}
<script type="application/ld+json">{{ crumbs | breadcrumbSchema(site.url) | safe }}</script>
{% endif %}

<!-- Google Analytics 4 — set the real ID in src/_data/site.json (GA_ID) -->
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.GA_ID }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '{{ site.GA_ID }}');
</script>
</head>
{# is-home flags the one page that already has its own hero background
   treatment (glow + grain + thumbnails, in index.njk) — used below only
   to keep the new sitewide grain layer from also applying there and
   stacking on top of what already exists. Doesn't change index.njk's
   own markup or rendering at all. #}
<body{{ ' class="is-home"' | safe if page.url == "/" }}>

{% include "partials/nav.njk" %}

<main>
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}

<script src="/script.js" defer></script>
</body>
</html>
