<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% set baseTitle = seoTitle or title %}
{% set pageTitle = (baseTitle + " — " + settings.title) if baseTitle else (settings.title + " — " + settings.tagline) %}
{% set pageDescription = metaDescription or settings.description %}
{% set pageImage = site.url + (ogImage or defaultOgImage or "/favicon.svg") %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}

<!-- Open Graph / Twitter — every value comes from src/_data/site.json's
     "url" field, so nothing here needs editing when the real domain
     goes live; just update that one field. -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ settings.title }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ pageImage }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ pageImage }}">

<!-- Google Fonts: Fraunces (headings) + Sora (body/UI) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="/style.css">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">

<!-- Google Analytics 4 — set the real ID in src/_data/site.json (GA_ID) -->
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.GA_ID }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '{{ site.GA_ID }}');
</script>
</head>
{# is-home flags the one page that already has its own hero background
   treatment (glow + grain + thumbnails, in index.njk) — used below only
   to keep the new sitewide grain layer from also applying there and
   stacking on top of what already exists. Doesn't change index.njk's
   own markup or rendering at all. #}
<body{{ ' class="is-home"' | safe if page.url == "/" }}>

{% include "partials/nav.njk" %}

<main>
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}

<script src="/script.js"></script>
</body>
</html>
