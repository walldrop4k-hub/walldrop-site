<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% if title %}{{ title }} — {{ settings.title }}{% else %}{{ settings.title }} — {{ settings.tagline }}{% endif %}</title>
<meta name="description" content="{{ metaDescription or settings.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">

<!-- Google Fonts: Fraunces (headings) + Sora (body/UI) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="/style.css">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">

<!-- Google Analytics 4 — set the real ID in src/_data/site.json (GA_ID) -->
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.GA_ID }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '{{ site.GA_ID }}');
</script>
</head>
<body>

{% include "partials/nav.njk" %}

<main>
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}

<script src="/script.js"></script>

<!-- Handles Netlify Identity invite/confirmation links, which land on the
     homepage as a #token before Netlify knows to send them to /admin/. -->
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", (user) => {
      if (!user) {
        window.netlifyIdentity.on("login", () => {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>
</body>
</html>
