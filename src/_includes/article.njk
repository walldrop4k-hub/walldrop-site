---
layout: base.njk
---
{% from "partials/macros.njk" import articleCard, mediaOrFallback with context %}
{% from "partials/breadcrumb.njk" import breadcrumbNav %}

  <section class="section" style="padding-bottom: 0;">
    <div class="section-inner readable">

      <!-- ============ BREADCRUMB ============ -->
      {{ breadcrumbNav(breadcrumbs) }}

      <!-- ============ ARTICLE HEADER ============ -->
      <div class="article-header">
        <p class="card-eyebrow">{{ category }}</p>
        <h1 class="page-title">{{ title }}</h1>
        <p class="article-meta">{{ date | readableDate }} · {{ readTime }}</p>
        <p class="article-byline">By {{ author or site.operator }}</p>
      </div>

      <!-- ============ FEATURED IMAGE ============ -->
      <div class="featured-image">
        {{ mediaOrFallback(featuredImage, imageAlt, "thumb-bg", gradientClass) }}
      </div>

      <!-- ============ ARTICLE BODY ============ -->
      <div class="article-body">
        {{ content | safe }}
      </div>

      <!-- ============ BROWSE WALLPAPERS ============ -->
      <p style="margin-top: 32px;">
        <a href="{{ browseUrl }}" class="btn btn-primary">Browse wallpapers</a>
      </p>

    </div>
  </section>

  <!-- ============ RELATED ARTICLES ============ -->
  <section class="section reveal">
    <div class="section-inner">
      <h2 class="section-title">Related articles</h2>
      <div class="article-grid reveal-group">
        {% set relatedList = collections.allArticles | excludeSlug(slug) %}
        {% for a in relatedList.slice(0, 3) %}{{ articleCard(a) }}{% endfor %}
      </div>
    </div>
  </section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | jsonify | safe }},
  "description": {{ excerpt | jsonify | safe }},
  "mainEntityOfPage": {{ (site.url + (page.url | canonicalPath)) | jsonify | safe }},
  {%- if image %}
  "image": {{ (site.url + image) | jsonify | safe }},
  {%- endif %}
  "author": { "@type": "Person", "name": {{ site.operator | jsonify | safe }} },
  "datePublished": {{ date | isoDate | jsonify | safe }},
  "dateModified": {{ date | isoDate | jsonify | safe }},
  "publisher": { "@type": "Organization", "name": {{ settings.title | jsonify | safe }} }
}
</script>
