---
layout: base.njk
---
{% from "partials/macros.njk" import wallpaperCard, mediaOrFallback with context %}
{% set cat = categories[category] | findBySlug(subcategory) %}
{% set ratio = "ratio-16-9" if category == "desktop" else "ratio-9-16" %}
{% set detailModifier = "" if category == "desktop" else " wallpaper-detail-mobile" %}
{% set typeLabel = "Desktop" if category == "desktop" else "Mobile" %}
{% set catName = cat.name if cat else subcategory %}

  <section class="section" style="padding-bottom: 0;">
    <div class="section-inner">

      <!-- ============ BREADCRUMB ============ -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/category/{{ category }}/{{ subcategory }}/">{{ typeLabel }}</a>
        <span>/</span>
        <a href="/category/{{ category }}/{{ subcategory }}/">{{ catName }}</a>
        <span>/</span>
        <span class="current">{{ title }}</span>
      </nav>

      <!-- ============ DETAIL LAYOUT ============ -->
      {# data-current-slug is what script.js's Prev/Next and "Surprise me"
         logic uses to identify this wallpaper — page.fileSlug, same as
         the save button and wallpapers-index.json, so it can never drift
         out of sync with a separate front-matter field. #}
      <div class="wallpaper-detail{{ detailModifier }}" data-current-slug="{{ page.fileSlug }}">

        <div class="preview-panel">
          {# Mobile-format (9:16) wallpapers get object-fit: contain — the
             box is height-capped on small screens, and a real photo rarely
             matches the 9:16 box exactly, so "cover" would crop it.
             Desktop (16:9) previews are unaffected — they already fit
             fine and stay "cover" as before. #}
          {{ mediaOrFallback(image, title, "preview-media " + ratio, gradientClass, "contain" if category == "mobile" else "cover") }}
          {# Hidden until script.js resolves a prev/next target (or finds
             none, e.g. first/last item — left hidden rather than wrapping
             around silently) so there's never a dead/broken link. #}
          <a href="#" class="detail-nav-btn detail-nav-prev" id="detail-prev-btn" aria-label="Previous wallpaper" hidden>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </a>
          <a href="#" class="detail-nav-btn detail-nav-next" id="detail-next-btn" aria-label="Next wallpaper" hidden>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
        </div>

        <aside class="detail-sidebar">
          <span class="tag" style="position: static; display: inline-flex; background: rgba(232,163,61,0.12); border-color: rgba(232,163,61,0.3); color: var(--accent);">{{ catName }}</span>
          <h1 class="detail-title">{{ title }}</h1>

          {% set downloadLabel = "Download" + (" — " + resolutions[0].label + " (" + resolutions[0].dimensions + ")" if resolutions and resolutions.length else "") %}
          <div class="download-row">
            {% if image %}
            <a href="{{ image }}" download="{{ slug }}-walldrop4k.{{ (format or 'jpg') | lower }}" class="btn btn-primary btn-large">{{ downloadLabel }}</a>
            {% else %}
            <button class="btn btn-primary btn-large" disabled style="opacity: 0.5; cursor: not-allowed;">{{ downloadLabel }}</button>
            {% endif %}
            {# data-wallpaper-id uses page.fileSlug (also what the URL and
               wallpapers-index.json are built from) rather than the
               front-matter "slug" field, so favorites always resolves
               correctly even if that field is ever out of sync with the
               filename. Toggle logic lives in script.js. #}
            <button type="button" class="save-btn" id="save-btn" data-wallpaper-id="{{ page.fileSlug }}" aria-label="Save to favorites" aria-pressed="false">
              <svg class="save-btn-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"></path>
              </svg>
            </button>
          </div>
          <p class="download-meta">{{ fileSize }}</p>

          <div class="info-rows">
            <div class="info-row"><span>Resolution</span><span>{{ resolutions[0].dimensions if resolutions and resolutions.length else "" }}</span></div>
            <div class="info-row"><span>File size</span><span>{{ fileSize }}</span></div>
            <div class="info-row"><span>Format</span><span>{{ format }}</span></div>
            <div class="info-row"><span>Category</span><span>{{ typeLabel }} · {{ catName }}</span></div>
            <div class="info-row"><span>Added</span><span>{{ date | readableDate }}</span></div>
          </div>

          <div class="tag-pills">
            {% for t in tags or [] %}<span class="pill">{{ t }}</span>{% endfor %}
          </div>
        </aside>

      </div>

      <!-- ============ DESCRIPTION ============ -->
      <div class="detail-description">
        {{ content | safe }}
      </div>

    </div>
  </section>

  <!-- ============ RELATED WALLPAPERS ============ -->
  <section class="section">
    <div class="section-inner">
      <h2 class="section-title">Related wallpapers</h2>
      <div class="{{ 'wallpaper-grid-desktop' if category == 'desktop' else 'wallpaper-grid-mobile' }}">
        {% set relatedList = (collections.desktopWallpapers if category == "desktop" else collections.mobileWallpapers) | excludeSlug(slug) %}
        {% for w in relatedList.slice(0, 3) %}{{ wallpaperCard(w) }}{% endfor %}
      </div>
    </div>
  </section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ImageObject",
  "name": {{ title | jsonify | safe }},
  "description": {{ content | plainText(200) | jsonify | safe }},
  "contentUrl": {{ (site.url + (image if image else "/favicon.svg")) | jsonify | safe }},
  "datePublished": {{ date | isoDate | jsonify | safe }},
  "keywords": {{ ((tags or []) | join(", ")) | jsonify | safe }},
  "width": {{ (resolutions[0].dimensions if resolutions and resolutions.length else "") | dimension("width") | jsonify | safe }},
  "height": {{ (resolutions[0].dimensions if resolutions and resolutions.length else "") | dimension("height") | jsonify | safe }}
}
</script>
