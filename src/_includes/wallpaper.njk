---
layout: base.njk
---
{% from "partials/macros.njk" import wallpaperCard, articleCard with context %}
{% from "partials/breadcrumb.njk" import breadcrumbNav %}
{% set cat = categories[category] | findBySlug(subcategory) %}
{% set typeLabel = "Desktop" if category == "desktop" else "Mobile" %}
{% set catName = cat.name if cat else subcategory %}
{% set glow = imageMeta.dominantColor if imageMeta else "#8b7bff" %}
{% set guides = collections.allArticles | byWallpaperFormat(category) %}
{% set relatedList = (collections.desktopWallpapers if category == "desktop" else collections.mobileWallpapers) | excludeSlug(slug) %}

  <section class="section wallpaper-page">
    <div class="section-inner">

      {{ breadcrumbNav(breadcrumbs) }}

      {# data-current-slug is read by script.js for the "Surprise me" button,
         so it never picks the wallpaper already on screen. #}
      <div class="wallpaper-detail" data-current-slug="{{ page.fileSlug }}" style="--glow:{{ glow }}">

        <div class="detail-stage">
          <div class="detail-glow" aria-hidden="true"></div>
          <div class="preview-panel">
            {# The 1920px WebP is what's shown. The download button below links
               to the original upload. Portrait images are shown whole. #}
            <img class="preview-media{{ ' ratio-9-16' if category == 'mobile' }}" src="{{ displayImage or image }}" alt="{{ imageAlt or title }}" width="{{ imageMeta.width if imageMeta }}" height="{{ imageMeta.height if imageMeta }}" fetchpriority="high" decoding="async" onload="this.classList.add('is-loaded')">
          </div>
        </div>

        <aside class="detail-sidebar">
          <h1 class="detail-title">{{ title }}</h1>

          <div class="info-rows">
            <div class="info-row"><span>Resolution</span><span>{% if imageMeta %}{{ imageMeta.dimensions }} · {{ imageMeta.label }}{% endif %}</span></div>
            <div class="info-row"><span>File size</span><span>{{ imageMeta.fileSize if imageMeta else "" }}</span></div>
            <div class="info-row"><span>Format</span><span>{{ imageMeta.format if imageMeta else "" }}</span></div>
            <div class="info-row"><span>Category</span><span>{{ typeLabel }} · {{ catName }}</span></div>
            <div class="info-row"><span>Added</span><span>{{ date | readableDate }}</span></div>
          </div>

          {% if tags and tags.length %}
          <div class="tag-pills">
            {% for t in tags %}<span class="pill">{{ t | trim }}</span>{% endfor %}
          </div>
          {% endif %}

          {% set downloadLabel = "Download" + (" " + imageMeta.label if imageMeta else "") %}
          <div class="download-row">
            {% if image %}
            <a href="{{ image }}" download="{{ slug }}-walldrop4k.{{ imageMeta.ext if imageMeta else 'jpg' }}" class="btn btn-primary btn-large">{{ downloadLabel }}</a>
            {% else %}
            <button class="btn btn-primary btn-large" disabled style="opacity: 0.5; cursor: not-allowed;">{{ downloadLabel }}</button>
            {% endif %}
            <button type="button" class="save-btn" id="save-btn" data-wallpaper-id="{{ page.fileSlug }}" aria-label="Save to favorites" aria-pressed="false">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"></path>
              </svg>
            </button>
          </div>
          <p class="download-meta">{{ imageMeta.fileSize if imageMeta else "" }}</p>
        </aside>

      </div>

      {# The write-up. Its headings and paragraphs are styled by
         .detail-description in style.css. #}
      <div class="detail-description">
        {{ content | safe }}
      </div>

    </div>
  </section>

  {% if guides.length %}
  <section class="section detail-related">
    <div class="section-inner">
      <h2 class="section-title">Related guides</h2>
      <div class="guides-grid reveal-group">
        {% for a in guides.slice(0, 2) %}{{ articleCard(a, false) }}{% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if relatedList.length %}
  <section class="section detail-related">
    <div class="section-inner">
      <h2 class="section-title">Related wallpapers</h2>
      <div class="{{ 'wallpaper-grid-desktop' if category == 'desktop' else 'wallpaper-grid-mobile' }} reveal-group">
        {% for w in relatedList.slice(0, 4) %}{{ wallpaperCard(w) }}{% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ImageObject",
  "name": {{ title | jsonify | safe }},
  "description": {{ content | plainText(200) | jsonify | safe }},
  "contentUrl": {{ (site.url + (image if image else "/favicon.svg")) | jsonify | safe }},
  "datePublished": {{ date | isoDate | jsonify | safe }},
  "keywords": {{ ((tags or []) | join(", ")) | jsonify | safe }},
  "width": {{ (imageMeta.width if imageMeta else "") | jsonify | safe }},
  "height": {{ (imageMeta.height if imageMeta else "") | jsonify | safe }}
}
</script>
