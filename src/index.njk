---
layout: base.njk
permalink: /index.html
metaDescription: "Browse hand-picked 4K and 8K wallpapers for desktop and mobile — free, curated, and updated with new drops every week."
---
{% from "partials/macros.njk" import wallpaperCard, trendingCard, articleCard with context %}

  <!-- ============ SEARCH ============ -->
  <section class="search-hero">
    <div class="hero-glow hero-glow-1" aria-hidden="true"></div>
    <div class="hero-glow hero-glow-2" aria-hidden="true"></div>
    {# Populated client-side from wallpapers-index.json — see script.js.
       Empty div here so there's nothing to show before JS runs rather
       than a flash of unstyled/misplaced markup. #}
    <div class="hero-thumbs" id="hero-thumbs" aria-hidden="true"></div>
    {# Rendered server-side (not client-side like .hero-thumbs above) since
       these are a few large, sharp, load-bearing visuals rather than many
       small blurred ones — no reason to wait on a client-side fetch for
       something this prominent. Picks straight from latestDropsDesktop,
       already available to this template and guaranteed non-empty. #}
    <div class="hero-cards" aria-hidden="true">
      {% for w in collections.latestDropsDesktop.slice(0, 3) %}
      <div class="hero-card hero-card-{{ loop.index }}" style="background-image:url('{{ w.data.cardImage }}')"></div>
      {% endfor %}
    </div>
    <div class="section-inner">
      <h1 class="search-hero-title">Find your next wallpaper</h1>
      <p class="search-hero-desc">Hand-picked 4K and 8K wallpapers for desktop and mobile. Free, no signup.</p>

      <form class="search-bar glass" action="/search/" method="get">
        <svg class="search-bar-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text" class="search-bar-input" name="q" placeholder="Search wallpapers, categories, or tags...">
        <button type="submit" class="search-bar-btn">Search</button>
      </form>

      <div class="search-popular">
        <span class="search-popular-label">Popular:</span>
        {% if occupiedCategories["desktop/4k"] %}<a href="/category/desktop/4k/" class="pill glass">4K</a>{% endif %}
        {% if occupiedCategories["desktop/dark"] %}<a href="/category/desktop/dark/" class="pill glass">Dark</a>{% endif %}
        {% if occupiedCategories["desktop/nature"] %}<a href="/category/desktop/nature/" class="pill glass">Nature</a>{% endif %}
        {% if occupiedCategories["desktop/gaming"] %}<a href="/category/desktop/gaming/" class="pill glass">Gaming</a>{% endif %}
        {% if occupiedCategories["desktop/minimal"] %}<a href="/category/desktop/minimal/" class="pill glass">Minimal</a>{% endif %}
        {% if occupiedCategories["mobile/iphone"] %}<a href="/category/mobile/iphone/" class="pill glass">iPhone</a>{% endif %}
      </div>
    </div>
  </section>

  <!-- ============ LATEST DROPS ============ -->
  <section class="section reveal" id="latest-drops">
    <div class="section-inner">
      <div class="section-title-row">
        <h2 class="section-title">Latest drops</h2>
        <div class="format-tabs glass" data-tabs="latest">
          <button class="format-tab" data-format="desktop">Desktop</button>
          <button class="format-tab" data-format="mobile">Mobile</button>
        </div>
      </div>

      <div class="tab-panel" data-panel-group="latest" data-panel="latest-desktop">
        <div class="wallpaper-grid-desktop">
          {% for w in collections.latestDropsDesktop %}{{ wallpaperCard(w, "fade-item") }}{% endfor %}
        </div>
      </div>

      <div class="tab-panel" data-panel-group="latest" data-panel="latest-mobile">
        <div class="wallpaper-grid-mobile">
          {% for w in collections.latestDropsMobile %}{{ wallpaperCard(w, "fade-item") }}{% endfor %}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ EXPLORE BY CATEGORY ============ -->
  <section class="section reveal">
    <div class="section-inner">
      <h2 class="section-title">Explore by category</h2>
      <div class="category-grid">
        {% set exploreCats = [
          { name: "4K", type: "desktop", slug: "4k" },
          { name: "Gaming", type: "desktop", slug: "gaming" },
          { name: "Nature", type: "desktop", slug: "nature" },
          { name: "Abstract", type: "desktop", slug: "abstract" },
          { name: "Dark", type: "desktop", slug: "dark" }
        ] %}
        {% for c in exploreCats %}
          {% set matches = collections.desktopWallpapers | byCategory(c.type, c.slug) %}
          {% if matches.length %}
          <a href="/category/{{ c.type }}/{{ c.slug }}/" class="category-card">
            <div class="category-card-bg" style="background-image:url('{{ matches[0].data.cardImage }}')"></div>
            <div class="category-card-scrim" aria-hidden="true"></div>
            <div class="category-card-info">
              <span class="category-card-name">{{ c.name }}</span>
              <span class="category-card-count">{{ matches.length }} wallpaper{{ "s" if matches.length != 1 }}</span>
            </div>
          </a>
          {% endif %}
        {% endfor %}
        {# "Mobile" spans every mobile subcategory rather than one specific
           slug (unlike the 5 desktop cards above) — links to iPhone, the
           same default the Trending/Latest "View all" links already use
           for mobile, since there's no single all-mobile browse page. #}
        {% if collections.mobileWallpapers.length %}
        <a href="/category/mobile/iphone/" class="category-card">
          <div class="category-card-bg" style="background-image:url('{{ collections.mobileWallpapers[0].data.cardImage }}')"></div>
          <div class="category-card-scrim" aria-hidden="true"></div>
          <div class="category-card-info">
            <span class="category-card-name">Mobile</span>
            <span class="category-card-count">{{ collections.mobileWallpapers.length }} wallpapers</span>
          </div>
        </a>
        {% endif %}
      </div>
    </div>
  </section>

  <!-- ============ TRENDING NOW ============ -->
  {% if collections.trendingDesktop.length >= 3 or collections.trendingMobile.length >= 3 %}
  <section class="section trending-section reveal">
    <div class="section-inner">
      <div class="section-title-row">
        <h2 class="section-title">Trending now</h2>
        <div class="section-title-actions">
          <div class="format-tabs glass" data-tabs="trending">
            <button class="format-tab" data-format="desktop">Desktop</button>
            <button class="format-tab" data-format="mobile">Mobile</button>
          </div>
          <a href="/category/desktop/4k/" class="view-all-link" data-view-all data-href-desktop="/category/desktop/4k/" data-href-mobile="/category/mobile/iphone/">View all <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>

      <div class="tab-panel" data-panel-group="trending" data-panel="trending-desktop">
        <div class="trending-grid-desktop">
          {% for w in collections.trendingDesktop %}{{ trendingCard(w, "lazy") }}{% endfor %}
        </div>
      </div>

      <div class="tab-panel" data-panel-group="trending" data-panel="trending-mobile">
        <div class="trending-grid-mobile">
          {% for w in collections.trendingMobile %}{{ trendingCard(w, "lazy") }}{% endfor %}
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  <!-- ============ FROM THE JOURNAL ============ -->
  <section class="section reveal">
    <div class="section-inner">
      <h2 class="section-title">From the journal</h2>
      <div class="article-grid">
        {% for a in collections.allArticles.slice(0, 3) %}{{ articleCard(a, false, "lazy") }}{% endfor %}
      </div>
    </div>
  </section>
