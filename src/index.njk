---
layout: base.njk
permalink: /index.html
---
{% from "partials/macros.njk" import wallpaperCard, trendingCard, categoryTile, articleCard with context %}

  <!-- ============ SEARCH ============ -->
  <section class="search-hero">
    <div class="section-inner">
      <h1 class="search-hero-title">Find your next wallpaper</h1>
      <p class="search-hero-desc">Hand-picked 4K and 8K wallpapers for desktop and mobile. Free, no signup.</p>

      <div class="search-bar glass">
        <svg class="search-bar-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text" class="search-bar-input" placeholder="Search wallpapers, categories, or tags...">
        <button type="button" class="search-bar-btn">Search</button>
      </div>

      <div class="search-popular">
        <span class="search-popular-label">Popular:</span>
        <a href="/category/desktop/4k/" class="pill glass">4K</a>
        <a href="/category/desktop/dark/" class="pill glass">Dark</a>
        <a href="/category/desktop/nature/" class="pill glass">Nature</a>
        <a href="/category/desktop/gaming/" class="pill glass">Gaming</a>
        <a href="/category/desktop/minimal/" class="pill glass">Minimal</a>
        <a href="/category/mobile/iphone/" class="pill glass">iPhone</a>
      </div>
    </div>
  </section>

  <!-- ============ TRENDING NOW ============ -->
  <section class="section trending-section reveal">
    <div class="section-inner">
      <div class="section-title-row">
        <h2 class="section-title">Trending now</h2>
        <div class="section-title-actions">
          <div class="format-tabs glass" data-tabs="trending">
            <button class="format-tab" data-format="desktop">Desktop</button>
            <button class="format-tab" data-format="mobile">Mobile</button>
          </div>
          <a href="/category/desktop/4k/" class="view-all-link">View all <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>

      <div class="tab-panel" data-panel-group="trending" data-panel="trending-desktop">
        <div class="trending-grid-desktop">
          {% for w in collections.trendingDesktop %}{{ trendingCard(w) }}{% endfor %}
        </div>
      </div>

      <div class="tab-panel" data-panel-group="trending" data-panel="trending-mobile">
        <div class="trending-grid-mobile">
          {% for w in collections.trendingMobile %}{{ trendingCard(w) }}{% endfor %}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CATEGORY RAIL ============ -->
  <section class="section category-section reveal">
    <div class="section-inner">
      <h2 class="section-title">Jump to a category</h2>
      <div class="category-rail">
        {% for slug in categories.homeTileDesktop %}{{ categoryTile(slug, "desktop") }}{% endfor %}
        {% for slug in categories.homeTileMobile %}{{ categoryTile(slug, "mobile") }}{% endfor %}
      </div>
    </div>
  </section>

  <!-- ============ LATEST DROPS ============ -->
  <section class="section reveal" id="latest-drops">
    <div class="section-inner">
      <div class="section-title-row">
        <h2 class="section-title">Latest drops</h2>
        <div class="format-tabs glass" data-tabs="latest">
          <button class="format-tab" data-format="desktop">Desktop</button>
          <button class="format-tab" data-format="mobile">Mobile</button>
        </div>
      </div>

      <div class="tab-panel" data-panel-group="latest" data-panel="latest-desktop">
        <div class="wallpaper-grid-desktop">
          {% for w in collections.desktopWallpapers %}{{ wallpaperCard(w, "fade-item") }}{% endfor %}
        </div>
      </div>

      <div class="tab-panel" data-panel-group="latest" data-panel="latest-mobile">
        <div class="wallpaper-grid-mobile">
          {% for w in collections.mobileWallpapers %}{{ wallpaperCard(w, "fade-item") }}{% endfor %}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ AD SLOT ============ -->
  <section class="section reveal">
    <div class="section-inner">
      <div class="ad-slot">Ad space</div>
    </div>
  </section>

  <!-- ============ FROM THE JOURNAL ============ -->
  <section class="section reveal">
    <div class="section-inner">
      <h2 class="section-title">From the journal</h2>
      <div class="article-grid">
        {% for a in collections.allArticles.slice(0, 3) %}{{ articleCard(a, false) }}{% endfor %}
      </div>
    </div>
  </section>
