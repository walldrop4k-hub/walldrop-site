---
layout: base.njk
permalink: /index.html
metaDescription: "Browse hand-picked 4K and 8K wallpapers for desktop and mobile — free, curated, and updated with new drops every week."
---
{% from "partials/macros.njk" import wallpaperCard, trendingCard, articleCard with context %}

  <!-- ============ HERO ============ -->
  {# Up to five of the newest featured desktop wallpapers crossfade behind
     the headline, each with a slow zoom (see .hero-slide in style.css). The
     first slide is in the HTML immediately, so the banner paints before any
     scripts run. #}
  <section class="search-hero hero-home">
    {# Only the first slide loads with the page, and it is the LCP image. The
       others carry their URLs in data-src and are given a source after the
       window load event (see script.js), so they never compete with it. #}
    {% for w in collections.heroWallpapers %}
    {% if loop.first %}
    <img class="hero-slide" src="{{ w.data.displayImage }}" srcset="{{ w.data.displayImageSrcset }}" sizes="100vw" alt="" aria-hidden="true" decoding="async" fetchpriority="high" style="--delay:0s">
    {% else %}
    <img class="hero-slide" data-src="{{ w.data.displayImage }}" data-srcset="{{ w.data.displayImageSrcset }}" sizes="100vw" alt="" aria-hidden="true" decoding="async" style="--delay:{{ loop.index0 * 5 }}s">
    {% endif %}
    {% endfor %}
    <div class="section-inner">
      <h1 class="search-hero-title">Find your next wallpaper</h1>
      <p class="search-hero-desc">Hand-picked 4K and 8K wallpapers for desktop and mobile. Free, no signup.</p>

      <form class="search-bar" action="/search/" method="get">
        <svg class="search-bar-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text" class="search-bar-input" name="q" placeholder="Search cars, anime, nature..." aria-label="Search wallpapers">
        <button type="submit" class="search-bar-btn">Search</button>
      </form>

      <div class="search-popular">
        <span class="search-popular-label">Popular:</span>
        {% if occupiedCategories["desktop/4k"] %}<a href="/category/desktop/4k/" class="pill">4K</a>{% endif %}
        {% if occupiedCategories["desktop/dark"] %}<a href="/category/desktop/dark/" class="pill">Dark</a>{% endif %}
        {% if occupiedCategories["desktop/nature"] %}<a href="/category/desktop/nature/" class="pill">Nature</a>{% endif %}
        {% if occupiedCategories["desktop/gaming"] %}<a href="/category/desktop/gaming/" class="pill">Gaming</a>{% endif %}
        {% if occupiedCategories["mobile/iphone"] %}<a href="/category/mobile/iphone/" class="pill">iPhone</a>{% endif %}
      </div>
    </div>
  </section>

  <!-- ============ MARQUEE ============ -->
  {# Two strips, one per screen size: desktop wallpapers in landscape tiles,
     and mobile wallpapers in portrait tiles. CSS shows one and hides the
     other (see .marquee-desktop / .marquee-mobile in style.css). Tiles are
     links to each wallpaper's page, and images are lazy-loaded so the hidden
     strip never downloads. The second pass repeats the list for a seamless
     loop; those copies are removed from the tab order. Tiles are CSS
     background images: a browser does not download the background of an
     element that is display:none, so the hidden strip loads nothing. #}
  {% set deskStrip = collections.desktopWallpapers.slice(0, 16) %}
  {% set mobStrip = collections.mobileWallpapers.slice(0, 16) %}
  {% if deskStrip.length %}
  <div class="marquee marquee-desktop" role="region" aria-label="Featured desktop wallpapers">
    <div class="track">
      {% for pass in [1, 2] %}
      {% for w in deskStrip %}
      <a href="{{ w.url }}" class="track-item" aria-label="{{ w.data.imageAlt or w.data.title }}" style="background-image:url('{{ w.data.cardImage }}')"{{ ' tabindex="-1" aria-hidden="true"' | safe if pass == 2 }}></a>
      {% endfor %}
      {% endfor %}
    </div>
  </div>
  {% endif %}
  {% if mobStrip.length %}
  <div class="marquee marquee-mobile" role="region" aria-label="Featured mobile wallpapers">
    <div class="track">
      {% for pass in [1, 2] %}
      {% for w in mobStrip %}
      <a href="{{ w.url }}" class="track-item" aria-label="{{ w.data.imageAlt or w.data.title }}" style="background-image:url('{{ w.data.cardImage }}')"{{ ' tabindex="-1" aria-hidden="true"' | safe if pass == 2 }}></a>
      {% endfor %}
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <!-- ============ LATEST DROPS (desktop) ============ -->
  <section class="section reveal">
    <div class="section-inner">
      <div class="section-title-row">
        <h2 class="section-title">Latest drops</h2>
        <a href="/category/desktop/4k/" class="view-all-link">View all <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="wallpaper-grid-desktop reveal-group">
        {% for w in collections.latestDropsDesktop %}{{ wallpaperCard(w) }}{% endfor %}
      </div>
    </div>
  </section>

  <!-- ============ MOBILE WALLPAPERS ============ -->
  {% if collections.latestDropsMobile.length %}
  <section class="section reveal">
    <div class="section-inner">
      <div class="section-title-row">
        <h2 class="section-title">Mobile wallpapers</h2>
        <a href="/category/mobile/iphone/" class="view-all-link">View all <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="wallpaper-grid-mobile reveal-group">
        {% for w in collections.latestDropsMobile.slice(0, 8) %}{{ wallpaperCard(w) }}{% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <!-- ============ EXPLORE BY CATEGORY ============ -->
  {# The eight most populated categories, each with its newest wallpaper as
     the background. The full list lives on /categories/. #}
  {% set topCats = collections.occupiedCategoryCards.slice(0, 8) %}
  {% if topCats.length %}
  <section class="section reveal">
    <div class="section-inner">
      <div class="section-title-row">
        <h2 class="section-title">Explore by category</h2>
        <a href="/categories/" class="view-all-link">View all categories <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="category-grid reveal-group">
        {% for c in topCats %}
        <a href="{{ c.url }}" class="category-card reveal">
          <div class="category-card-bg" style="background-image:url('{{ c.cover }}')"></div>
          <div class="category-card-scrim" aria-hidden="true"></div>
          <div class="category-card-info">
            <span class="category-card-name">{{ c.name }}</span>
            <span class="category-card-count">{{ c.count }} wallpaper{{ "s" if c.count != 1 }}</span>
          </div>
        </a>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <!-- ============ TRENDING NOW ============ -->
  {% if collections.trendingDesktop.length >= 3 or collections.trendingMobile.length >= 3 %}
  <section class="section trending-section reveal">
    <div class="section-inner">
      <div class="section-title-row">
        <h2 class="section-title">Trending now</h2>
        <div class="section-title-actions">
          <div class="format-tabs" data-tabs="trending">
            <button class="format-tab" data-format="desktop">Desktop</button>
            <button class="format-tab" data-format="mobile">Mobile</button>
          </div>
          <a href="/category/desktop/4k/" class="view-all-link" data-view-all data-href-desktop="/category/desktop/4k/" data-href-mobile="/category/mobile/iphone/">View all <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>

      <div class="tab-panel" data-panel-group="trending" data-panel="trending-desktop">
        <div class="trending-grid-desktop reveal-group">
          {% for w in collections.trendingDesktop %}{{ trendingCard(w) }}{% endfor %}
        </div>
      </div>

      <div class="tab-panel" data-panel-group="trending" data-panel="trending-mobile">
        <div class="trending-grid-mobile reveal-group">
          {% for w in collections.trendingMobile %}{{ trendingCard(w) }}{% endfor %}
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  <!-- ============ FROM THE JOURNAL ============ -->
  {% if collections.allArticles.length %}
  <section class="section reveal">
    <div class="section-inner">
      <div class="section-title-row">
        <h2 class="section-title">From the journal</h2>
        <a href="/articles/" class="view-all-link">All articles <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="article-grid reveal-group">
        {% for a in collections.allArticles.slice(0, 3) %}{{ articleCard(a, false) }}{% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <!-- ============ NEWSLETTER ============ -->
  {# Presentation only. No signup endpoint is connected yet. #}
  <section class="section reveal newsletter-band">
    <div class="section-inner">
      <div class="newsletter-inner">
        <h2 class="section-title">Never miss a drop</h2>
        <p class="newsletter-desc">New wallpapers and curated picks straight to your inbox. No spam, unsubscribe anytime.</p>
        <form class="newsletter-form">
          <input type="email" class="newsletter-input" name="email" placeholder="you@example.com" aria-label="Email address" required>
          <button type="submit" class="search-bar-btn">Subscribe</button>
        </form>
      </div>
    </div>
  </section>
