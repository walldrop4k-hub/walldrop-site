---js
{
  layout: "base.njk",
  pagination: {
    data: "categoryPages",
    size: 1,
    alias: "cat",
    // Eleventy only adds a paginated template's FIRST output page to
    // collections by default — without this, collections.all (used by
    // sitemap.njk) only ever saw one category page total, regardless of
    // how many actually exist.
    addAllPagesToCollections: true
  },
  eleventyComputed: {
    title: (data) => `${data.cat.type === "desktop" ? "Desktop" : "Mobile"} ${data.cat.name} Wallpapers`,
    permalink: (data) => `/category/${data.cat.type}/${data.cat.slug}/index.html`,
    metaDescription: (data) => data.cat.description,
    // Empty categories stay reachable (a friendly page, not a dead link)
    // but shouldn't be indexed as thin/duplicate content until they have
    // real wallpapers in them.
    noindex: (data) => !data.occupiedCategories[`${data.cat.type}/${data.cat.slug}`]
  }
}
---
{% from "partials/macros.njk" import wallpaperCard with context %}
{% set gridClass = "wallpaper-grid-desktop" if cat.type == "desktop" else "wallpaper-grid-mobile" %}
{% set chips = categories.chipsDesktop if cat.type == "desktop" else categories.chipsMobile %}
{% set typeLabel = "Desktop" if cat.type == "desktop" else "Mobile" %}

  <!-- ============ CATEGORY HEADER ============ -->
  <section class="page-intro-section">
    {# Same subtle ambient glow as the Search page's hero — see the
       comment there (search.njk) for why it's the quieter .ambient-glow
       version rather than the Home page's own .hero-glow. #}
    <div class="ambient-glow ambient-glow-1" aria-hidden="true"></div>
    <div class="ambient-glow ambient-glow-2" aria-hidden="true"></div>
    <div class="section-inner">
      <p class="eyebrow">{{ typeLabel }} Wallpapers</p>
      <h1 class="page-title">{{ cat.name }}</h1>
      <p class="page-desc">{{ cat.description }}</p>
    </div>
  </section>

  <!-- ============ FILTERS + SORT ============ -->
  <section class="section" style="padding-top: 0;">
    <div class="section-inner">

      <div class="filter-bar" id="filter-bar">
        <div class="chip-row" id="chip-row">
          {% for chip in chips %}
          <button class="chip{{ ' is-active' if loop.first }}" data-chip="{{ chip | lower }}">{{ chip }}</button>
          {% endfor %}
        </div>
        <select class="sort-select" id="sort-select">
          <option value="latest">Latest</option>
          <option value="oldest">Oldest first</option>
          <option value="random">Random</option>
        </select>
      </div>

      <!-- ============ WALLPAPER GRID ============ -->
      {% set matches = collections.allWallpapers | byCategory(cat.type, cat.slug) %}
      <div class="{{ gridClass }}" id="wallpaper-grid">
        {% for w in matches %}
        {{ wallpaperCard(w) }}
        {% else %}
        <p class="page-desc">No wallpapers here yet — check back soon, or browse another category in the meantime.</p>
        {% endfor %}
      </div>
      {# Was a bare, unstyled <p> before — easy to miss and gave no way
         back except manually re-clicking "All". Now matches the
         Favorites page's empty-state pattern (centered block + message
         + a real CTA), and the button actively resets the filter
         instead of just describing what to do. script.js wires the
         click. #}
      <div id="chip-empty" hidden style="text-align: center; padding: 40px 0;">
        <p class="page-desc">No wallpapers match this filter yet — check back soon, or view everything in this category.</p>
        <button type="button" class="btn btn-primary" id="chip-empty-reset" style="margin-top: 20px; display: inline-flex;">View all in this category</button>
      </div>

    </div>
  </section>
